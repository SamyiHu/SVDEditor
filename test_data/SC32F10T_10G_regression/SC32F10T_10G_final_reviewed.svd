        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>DMA2</name>
        <description>优先级=可设；NVIC=NVIC-&gt;ISER[0].13；屏蔽位=DMA2_CFG-&gt;INTEN；子开关=DMA2_CFG-&gt;TCIE
DMA2_CFG-&gt;HTIE
DMA2_CFG-&gt;TEIE；标志位=DMA2_STS-&gt;GIF 
DMA2_STS-&gt;TCIF
DMA2_STS-&gt;HTIF
DMA2_STS-&gt;TEIF；唤醒 STOP=不能</description>
        <value>13</value>
      </interrupt>
