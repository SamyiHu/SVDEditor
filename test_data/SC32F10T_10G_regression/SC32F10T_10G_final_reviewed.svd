    </peripheral>
    <peripheral>
      <name>LEDPWM</name>
      <description>LEDPWM</description>
      <groupName/>
      <baseAddress>0x40022300</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1C</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>LEDPWM</name>
        <description>优先级=可设；NVIC=NVIC-&gt;ISER[0].22；屏蔽位=LEDPWM_CON-&gt;INTEN；标志位=LEDPWM_STS&gt;PWMIF；唤醒 STOP=不能</description>
        <value>22</value>
      </interrupt>
      <registers>
        <register>
          <name>LEDPWM_CON</name>
          <description>LEDPWM控制寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>INTEN</name>
              <description>中断请求 CPU 的使能控制位0：禁止中断请求1：使能中断请求</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ENPWM</name>
              <description>PWM模块开关控制位
1：允许Clock进到 PWM 单元，PWM处于工作状态，PWM输出口的状态由寄存器ENPWMx控制（x=0~7）
0：PWM单元停止工作，PWM计数器清零，全部 PWM输出口设置为GPIO状态</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PWMMD0</name>
              <description>PWM波形对齐模式选择位0：边沿对齐模式
1：中心对齐模式</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PWMCK</name>
              <description>PWM时钟频率档位控制位用于设定LEDPWM时钟频率fLEDPWM000：fPCLK2/1001：fPCLK2/2010：fPCLK2/4011：fPCLK2/8100：fPCLK2/16101：fPCLK2/32110：fPCLK2/64111：fPCLK2/128</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LEDPWM_CHN</name>
          <description>LEDPWM通道设置寄存器</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>ENPWMxx</name>
              <description>LEDPWMx波形输出选择0：LEDPWMx输出被关闭并作为GPIO1：当ENPWM=1时，LEDPWMx所在的管脚作为波形输出口说明：如果ENPWM置1，PWM模块被打开，但ENPWMx=0，PWM输出被关闭并作为GPIO口。此时PWM模块可以作为一个16位Timer使用，若此时LEDPWM_CON.INTEN =1，PWM仍然会产生中断。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LEDPWM_STS</name>
          <description>LEDPWM状态标志寄存器</description>
          <addressOffset>0x8</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>PWMIF</name>
              <description>LEDPWM中断请求标志位该位由硬件置1，通过软件写1清0。当PWM 计数器溢出时(即: 计数值超过 PWMPD时)，该位由硬件置1 。如果此时LEDPWM.INTEN = 1，将产生 LEDPWM 中断 。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LEDPWM_INV</name>
          <description>LEDPWM波形输出反向控制寄存器</description>
          <addressOffset>0xC</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>INVxX</name>
              <description>LEDPWMx波形输出反向控制1：LEDPWMx波形输出反向0：LEDPWMx波形输出不反向</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LEDPWM_CYCLE</name>
          <description>LEDPWM周期寄存器</description>
          <addressOffset>0x18</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>PWMPD</name>
              <description>LEDPWM周期设置位此数值代表 PWM输出波形的 (周期–1); 即PWM输出的周期值为（PWMPD[7:0] + 1 ）* fLEDPWM ;</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>LCD</name>
      <description>LCD/LED</description>
      <groupName/>
      <baseAddress>0x40022280</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x10</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>DDR_CON</name>
          <description>显示驱动控制寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>DDRCK</name>
              <description>LCD/LED频帧分频设置位00：B波形帧频64Hz，A波形频帧32Hz01：B波形帧频128Hz，A波形频帧64Hz10：B波形帧频256Hz，A波形频帧128Hz11：保留</description>
              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DDRON</name>
              <description>LCD/LED显示驱动使能控制位0：显示驱动扫描关闭1：显示驱动扫描打开</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TPYE</name>
              <description>LCD驱动波形选择位0：B波形1：A波形注意：在LED模式下，修改该位也会影响到LED的波形频率</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>VOIRSIF</name>
              <description>LCD快速充电使能位0：关闭快速充电1：打开快速充电，选择33k电阻快速充电5个周期，之后切换到VOIRS选择的电阻值</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BIAS</name>
              <description>LCD显示驱动偏置电压设置0：1/4偏置电压1：1/3偏置电压</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DMOD</name>
              <description>LCD/LED显示驱动模式选择位0： LCD模式1： LED模式</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DDR_CFG</name>
          <description>显示驱动配置寄存器</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>VLCD</name>
              <description>LCD电压调节设置位LCD的输出电压： VLCD = VDD*(17+VLCD[3:0])/32</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SCS</name>
              <description>LCD/LED Segment/Common复用管脚选择位
0：设定1/4占空比时，S0~S27为segment，C4~C7为common
1：设定1/4占空比时，S4~S27为segment，C0~C3为common</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DUTY</name>
              <description>LCD/LED显示占空比设置位
00：1/8占空比，S4~S27为segment，C0~C7为common
01：1/6占空比，S2~S27为segment，C2~C7为common
10：1/5占空比，S1~S27为segment，C3~C7为common
11：1/4占空比，S0~S27为segment，C4~C7为common或S4~S27为segment，C0~C3为common</description>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>VOIRS</name>
              <description>LCD电压输出口分压电阻选择位00：设定内部分压电阻总电阻值为33k01：设定内部分压电阻总电阻值为100k10：设定内部分压电阻总电阻值为300k11：设定内部分压电阻总电阻值为800k</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SEG_EN</name>
          <description>SEG口使能寄存器</description>
          <addressOffset>0x8</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>SEGx（x</name>
              <description>SEGx口显示驱动输出控制位，x= 0~270：关闭SEGx口的显示驱动输出功能1：打开SEGx口的显示驱动输出功能</description>
              <bitOffset>0</bitOffset>
              <bitWidth>28</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>COM_EN</name>
          <description>COM口使能寄存器</description>
          <addressOffset>0xC</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>COMx（x</name>
              <description>COMx口显示驱动输出控制位，x= 0~70：关闭COMx口的显示驱动输出功能1：打开COMx口的显示驱动输出功能</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
