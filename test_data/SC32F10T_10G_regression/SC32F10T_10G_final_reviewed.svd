          <resetValue>0x0</resetValue>
        </register>
        <register>
          <name>PACON</name>
          <description>PA口输入/输出控制寄存器</description>
          <addressOffset>0x20</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
        </register>
        <register>
          <name>PAPH</name>
          <description>PA口上拉电阻控制寄存器</description>
