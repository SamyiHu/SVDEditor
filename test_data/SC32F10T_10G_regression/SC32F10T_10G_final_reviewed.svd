<?xml version="1.0" encoding="utf-8" standalone="no"?>
  <device schemaVersion="1.3"
    xmlns:xs="http://www.w3.org/2001/XMLSchema-instance"
    xs:noNamespaceSchemaLocation="CMSIS-SVD_Schema_1_3.xsd">
  <name>SC32F10T_10G</name>
  <version>1.0</version>
  <description>SC32F10T_10G</description>
  <cpu>
    <name>CM0+</name>
    <revision>r0p1</revision>
    <endian>little</endian>
    <mpuPresent>true</mpuPresent>
    <fpuPresent>false</fpuPresent>
    <nvicPrioBits>4</nvicPrioBits>
    <vendorSystickConfig>false</vendorSystickConfig>
  </cpu>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>0x20</size>
  <resetValue>0x0</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <peripherals>
    <peripheral>
      <name>IAP</name>
      <description>IAP</description>
      <groupName/>
      <baseAddress>0x400003C0</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x10</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>IAP_KEY</name>
          <description>数据保护寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>IAPKEY</name>
              <description>数据保护锁为防止因电气干扰等原因出现对Flash的意外操作，IAP_CON寄存器执行写操作前需要通过IAPKEY解锁。解锁顺序如下：写入 KEY1 = 0x1234_5678写入 KEY2 = 0xA05F_05FA如果操作顺序不正确，会锁定 IAP_CON 寄存器，直到下次系统复位才会解锁。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IAP_SNB</name>
          <description>IAP扇区编号设置寄存器</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>IAPADE</name>
              <description>IAP操作区域扩展地址通过向IAPADE写入不同的值，使得IAP操作指向不同的操作区域：0x00：无效0x4C：APROM其它：保留</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>IAPSNB</name>
              <description>扇擦/页擦时的IAP 操作扇区编号设置：实际操作扇区的起始地址= Flash 基址 + [ STARTB[8:0] x 0x200 ]</description>
              <bitOffset>0</bitOffset>
              <bitWidth>9</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>IAP_CON</name>
          <description>IAP控制寄存器</description>
          <addressOffset>0xC</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>LOCK</name>
              <description>对该位写1后，IAP_CON 寄存器被锁定。当检测到解锁序列时，由硬件将该位清0。如果解锁操作失败，该位仍保持置 1，直到下一次系统复位。</description>
              <bitOffset>31</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BTLD</name>
              <description>软件复位后程序启动区域选择位：00：芯片软件复位后从APROM（主存储区）启动01：芯片软件复位后从LDROM（系统存储区）启动10：芯片软件复位后从嵌入式SRAM启动11：保留</description>
              <bitOffset>9</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RST</name>
              <description>软件复位控制位0：程序正常运行1：对该位写1后系统立刻复位</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ERASE</name>
              <description>全擦（All Erase）控制位0：无操作1：对该位写1后再配置CMD[1:0]=10，则进入APROM全擦除操作，APROM将全部擦除</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SERASE</name>
              <description>扇区擦除（Sector Erase）控制位0：无操作1：对该位写1后再配置CMD[1:0]=10，则进入APROM扇区擦除操作，APROM的指定Sector将被擦除</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PRG</name>
              <description>编程（Program）控制位0：禁止 Flash 编程1：使能 Flash 编程</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CMD</name>
              <description>IAP命令使能控制位10：执行擦除操作命令其它 : 保留注意：擦除操作命令位写1后，必须配置CMD[1:0]=10，相应的操作才会开始执行一次只能执行1种IAP操作，所以ERASE/SERASE位同一时间只能有一位置1</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>RCC</name>
      <description>RCC</description>
      <groupName/>
      <baseAddress>0x40003000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x30</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>RCC</name>
        <description>优先级=可设；NVIC=NVIC-&gt;ISER[0].4；屏蔽位=RCC_CFG-&gt;INTEN；标志位=RCC_STS-&gt;CLKFIF；唤醒 STOP=不能</description>
        <value>4</value>
      </interrupt>
      <registers>
        <register>
          <name>AHB_CFG</name>
          <description>AHB总线外设时钟使能寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <resetValue>0x200000</resetValue>
          <fields>
            <field>
              <name>CLKDIV</name>
              <description>AHB时钟分频设置位AHB总线时钟HCLK来自系统时钟SYSCLK的分频：000: fHCLK= fSYSCLK001: fHCLK= fSYSCLK / 2010: fHCLK= fSYSCLK / 4011: fHCLK= fSYSCLK / 8100: fHCLK= fSYSCLK / 16其它：保留</description>
              <bitOffset>20</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>IFBEN</name>
              <description>Customer Option映射寄存器时钟使能位使用OPINX配合OPREG改写IFB映射寄存器之前，应先要打开时钟使能。 0：禁止1：使能</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CRCEN</name>
              <description>CRC模块时钟使能位0：禁止1：使能</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DMAEN</name>
              <description>DMA时钟使能位0：禁止1：使能</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AHB_RST</name>
          <description>AHB总线外设复位控制寄存器</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>CRCRST</name>
              <description>CRC复位控制位该位通过软件写1，由硬件自动清0。0：无影响1：复位RCC</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DMARST</name>
              <description>DMA复位控制位该位通过软件写1，由硬件自动清0。0：无影响1：复位DMA</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RCC_KEY</name>
          <description>RCC保护寄存器</description>
          <addressOffset>0xC</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>RCCKEY</name>
              <description>RCC_CFG0、RCC_CFG1、PLL_CFG这三个寄存器的操作使能开关及时限设置。写入一个大于等于0x40的值n，代表：打开RCC_CFG0、RCC_CFG1、PLL_CFG这三个寄存器的写操作功能；n个系统时钟后如果接收不到寄存器写入命令，则RCC改写功能被重新关闭。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RCC_CFG0</name>
          <description>系统时钟源选择寄存器</description>
          <addressOffset>0x14</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>INTEN</name>
              <description>中断请求 CPU的使能控制位
0：禁止中断请求
1：使能中断请求</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>HPLDO_DP</name>
              <description>低频系统时钟功耗调整位0：系统时钟源非LIRC推荐设置。1：系统时钟源选择LIRC推荐设置。当系统时钟选择LIRC，此位写1可降低整体功耗</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SYSCLKSEL</name>
              <description>系统时钟源选择位00：系统时钟源来自LIRC01：系统时钟源来自HXT10：系统时钟源来自PLLR11：系统时钟源来自LXT注意：上电默认的系统时钟源为HIRC，用户可在上电后的正常操作阶段，通过软件方式切换时钟源。切换前务必确保所选时钟源已处于稳定的工作状态；系统时钟源无论选择切换至哪一种，都必须先将系统时钟源切换至HIRC，再切换至目标时钟源。</description>
              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SYSCLKSW</name>
              <description>系统时钟源切换位，使能后系统时钟源从HIRC切换至SYSCLKSEL所选的时钟：0：系统时钟源为HIRC1：系统时钟源为SYSCLKSEL设置项对此位改写后，必须内部电路切换成功才会更新改写的值，否则读到的一直是改写前的状态。用户可以通过读取此位的方式判断时钟源是否已切换成功。复位/唤醒后此位将自动清零，即复位/唤醒后由HIRC提供系统时钟。注意：上电默认的系统时钟源为HIRC，用户可在上电后的正</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>HIRCEN</name>
              <description>内建高频32MHz振荡器HIRC使能位0：禁止1：使能当SYSCLKSW = 0，选择HIRC作为系统时钟时，此位不可写入。复位/唤醒后此位将由硬件置1，即复位/唤醒后由HIRC提供系统时钟。</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>HXTEN</name>
              <description>外接高频晶振HXT使能位0：禁止1：使能复位/唤醒后此位将自动清零。</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CRY_HF</name>
              <description>外接高频晶振HXT振荡频率范围选择位0：外接晶振振荡频率&lt;12M1：外接晶振振荡频率≥12M</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LIRCEN</name>
              <description>内建低频32kHz振荡器LIRC使能位0：禁止1：使能</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LXTEN</name>
              <description>外接低频晶振LXT使能位0：禁止1：使能</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RCC_CFG1</name>
          <description>外设时钟源选择寄存器</description>
          <addressOffset>0x18</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>STCLKSEL</name>
              <description>SysTick时钟源选择位000：时钟源来自HCLK/8001：时钟源来自HIRC/2010：时钟源来自HXT/2011：时钟源来自LIRC100：时钟源来自LXT注意：用户配置时注意，如果 SysTick时钟源不是来自HCLK，SysTick时钟源频率必须小于或等于fHCLK/2。</description>
              <bitOffset>5</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>LCDCLKSEL</name>
              <description>LCD时钟源选择位0：时钟源来自LIRC1：时钟源来自LXT对此位改写后，必须等待内部电路切换成功才会更新改写的值，否则读到的一直是改写前的状态。用户可以通过读取此位的方式判断时钟源是否已切换成功。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>BTMCLKSEL</name>
              <description>BTM时钟源选择位0：时钟源来自LIRC1：时钟源来自LXT对此位改写后，必须等待内部电路切换成功才会更新改写的值，否则读到的一直是改写前的状态。用户可以通过读取此位的方式判断时钟源是否已切换成功。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PLL_CFG</name>
          <description>PLL配置寄存器</description>
          <addressOffset>0x1C</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>PLLCLKSEL</name>
              <description>PLL时钟源选择位1：PLL时钟源来自外部高速晶振 HXT，PLL输入时钟的频率fPLL_IN = fHXT0：PLL时钟源来自内部高速震荡时钟 HIRC，PLL输入时钟的频率fPLL_IN = fHIRC注意：只有在禁止 PLL 时才能写入此位域。</description>
              <bitOffset>23</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DIVM</name>
              <description>PLL时钟源预分频有效值：0x01~0x1F注意：用户需自行配置保证PLL输入频率分至2MHz。</description>
              <bitOffset>16</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DIVN</name>
              <description>PLL倍频系数2 &lt;= N &lt;=192 0x00、0x01及大于192的值：无效计算公式：fPLLR = [ ( fPLL_IN / DIVM ) * DIVN ] /  2 ^ ( DIVP +1 )注意：用户需自行配置保证倍频后频率保持在200MHz ~ 400MHz之间, 之后用户需自行配置DIVP分频保证输出频率PLLR不高于64MHz， PLLR可作为系统时钟源。</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PLLON</name>
              <description>PLL使能位0：PLL关闭1：PLL使能当进入停止、待机或关断模式时由硬件清零。注意：如果 PLL 时钟用作系统时钟，则此位不可为0。</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PLLREN</name>
              <description>PLLRCLK 时钟输出使能位0：禁止1：使能选择 PLL 的 PLLRCLK 输出作为系统时钟时，此位不可写入。</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DIVP</name>
              <description>PLLRCLK 时钟输出分频系数00：2分频01：4分频10：8分频11：16分频只有在禁止 PLL 时才能写入此位域。可选择 PLLRCLK 时钟作为系统时钟。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RCC_STS</name>
          <description>时钟状态寄存器</description>
          <addressOffset>0x20</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>PLLRDY</name>
              <description>PLL 时钟就绪标志位该位只读，由硬件置 1，用于指示 PLL 已锁定。0：PLL 未锁定1：PLL 已锁定</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SYST_CALIB</name>
          <description>SysTick校准参数寄存器</description>
          <addressOffset>0x28</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>CALIB</name>
              <description>校准寄存器默认值：若，上电默认时钟为fHCLK/n（MHz），n是上电默认分频系数，上电默认时钟源为HIRC则，SysTick 校准值初始值为1000*（fHCLK/n），即保证默认可产生1ms时间基准</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>NMI_CFG</name>
          <description>NMI中断配置寄存器</description>
          <addressOffset>0x2C</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>KEY</name>
              <description>NMI_CFG寄存器写保护开关向KEY[15:0]写入 0xA05F解锁后才能对当前寄存器的低位进行改写操作。</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INT0EN</name>
              <description>外部中断INT0非屏蔽中断源使能位0：INT0禁止触发NMI1：INT0非屏蔽中断源使能使能后，INT0口上的上升/下降沿中断均会触发NMI，手动清除相应标志位后方可退出NMI中断。注意：若INT0中断已使能，仍会优先处理NMI。</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CMPEN</name>
              <description>比较器非屏蔽中断源使能位0：CMP禁止触发NMI1：CMP非屏蔽中断源使能使能后，CMPIF置起时会触发NMI，手动清除CMPIF标志后方可退出NMI中断。注意：如果CMP中断使能已开启（CMPCFG-&gt;CMPIM[1:0]=1），仍会优先处理NMI。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CSSEN</name>
              <description>时钟安全系统非屏蔽中断源使能位0：CSS禁止触发NMI1：CSS系统非屏蔽中断源使能使能后，CLKFIF置起时会触发NMI，复位后可清除CLKFIF标志。注意：如果RCC中断使能已开启（RCC_CFG0.INTEN=1），仍会优先处理NMI。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>INTF</name>
      <description>外部中断</description>
      <groupName/>
      <baseAddress>0x40011300</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0xE4</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>INT0</name>
        <description>优先级=可设；NVIC=NVIC-&gt;ISER[0].0；屏蔽位=INTF_IE-&gt;ENFx，x=0
INTR_IE-&gt;ENRx；标志位=INTF_STS-&gt;FIFx
INTR_STS-&gt;RIFx；唤醒 STOP=能</description>
        <value>0</value>
      </interrupt>
      <interrupt>
        <name>INT1_7</name>
        <description>优先级=可设；NVIC=NVIC-&gt;ISER[0].1；屏蔽位=INTF_IE-&gt;ENFx，x=1~7
INTR_IE-&gt;ENRx；标志位=INTF_STS-&gt;FIFx
INTR_STS-&gt;RIFx；唤醒 STOP=能</description>
        <value>1</value>
      </interrupt>
      <interrupt>
        <name>INT8_11</name>
        <description>优先级=可设；NVIC=NVIC-&gt;ISER[0].2；屏蔽位=INTF_IE-&gt;ENFx，x=8~11
INTR_IE-&gt;ENRx；标志位=INTF_STS-&gt;FIFx
INTR_STS-&gt;RIFx；唤醒 STOP=能</description>
        <value>2</value>
      </interrupt>
      <interrupt>
        <name>INT12_15</name>
        <description>优先级=可设；NVIC=NVIC-&gt;ISER[0].3；屏蔽位=INTF_IE-&gt;ENFx，x=12~15
INTR_IE-&gt;ENRx；标志位=INTF_STS-&gt;FIFx
INTR_STS-&gt;RIFx；唤醒 STOP=能</description>
        <value>3</value>
      </interrupt>
      <registers>
        <register>
          <name>INTF_IE</name>
          <description>INT中断下降沿使能寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>ENFx（x</name>
              <description>INTx下降沿中断使能控制位（x=0~15）0：无效1：使能</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INTR_IE</name>
          <description>INT中断上升沿使能寄存器</description>
          <addressOffset>0x20</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>ENRx（x</name>
              <description>INTx上升沿中断使能控制位（x=0~15）0：无效1：使能</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INT_SEL0</name>
          <description>外部中断端口选择寄存器0</description>
          <addressOffset>0x40</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>INTxSEL（x</name>
              <description>外部中断INTx端口选择位（x=0~7）0000：选择PAx端口0001：选择PBx端口0010：选择PCx端口其它：保留</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INT_SEL1</name>
          <description>外部中断端口选择寄存器1</description>
          <addressOffset>0x60</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>INTxSEL（x</name>
              <description>外部中断INTx端口选择位（x=8~15）0000：选择PAx端口0001：选择PBx端口0010：选择PCx端口其它：保留</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INTF_CON</name>
          <description>外部中断下降沿控制寄存器</description>
          <addressOffset>0x80</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>FTx（x</name>
              <description>INTx下降沿检测使能（x=0~15）0：无效1：使能</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INTR_CON</name>
          <description>外部中断上升沿控制寄存器</description>
          <addressOffset>0xA0</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>RTx（x</name>
              <description>INTx上升沿检测使能（x=0~15）0：无效1：使能</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INTF_STS</name>
          <description>外部中断下降沿标志寄存器</description>
          <addressOffset>0xC0</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>FIFx（x</name>
              <description>INTx端口下降沿捕获标志位（x=0~15）检测到下降沿，该位由硬件置1，通过软件写0清0。也可通过软件对该位写1触发下降沿捕获中断。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INTR_STS</name>
          <description>外部中断上升沿标志寄存器</description>
          <addressOffset>0xE0</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>RIFx（x</name>
              <description>INTx端口上升沿捕获标志位（x=0~15）检测到上升沿，该位由硬件置1，通过软件写0清0。也可通过软件对该位写1触发上升沿捕获中断。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>PA</name>
      <description>PA</description>
      <groupName/>
      <baseAddress>0x40011000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x64</size>
        <usage>registers</usage>
