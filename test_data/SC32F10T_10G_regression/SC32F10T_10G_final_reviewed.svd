    <peripheral>
      <name>PC</name>
      <description>PC</description>
      <groupName/>
      <baseAddress>0x40011200</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x64</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>PC</name>
          <description>PC端口数据寄存器</description>
