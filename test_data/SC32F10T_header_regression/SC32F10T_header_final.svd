    <peripheral>
      <name>SPI0</name>
      <description>SPI0</description>
      <groupName/>
      <baseAddress>0x40020040</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x14</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>SPI0</name>
        <description>&lt; SPI0 Interrupts</description>
        <value>9</value>
      </interrupt>
      <registers>
        <register>
          <name>SPI_CON</name>
          <description>SPI控制寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>MSTR</name>
              <description>SPI主从机模式选择位0：SPI0为从设备1：SPI0为主设备</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SPMD</name>
              <description>SPI传输模式选择位0：8位模式1：16位模式</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DORD</name>
              <description>SPI传送方向选择位0：MSB优先发送1：LSB优先发送</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CPHA</name>
              <description>SPI时钟相位控制位0：SCK周期的第一沿采集数据1：SCK周期的第二沿采集数据</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CPOL</name>
              <description>SPI时钟极性控制位0：SCK在空闲状态下为低电平1：SCK在空闲状态下为高电平</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SPEN</name>
              <description>SPI使能控制位0：关闭SPI01：打开SPI0</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SPR</name>
              <description>SPI时钟预分频控制位0000：fPCLK00001：fPCLK0 /20010：fPCLK0 /40011：fPCLK0 /80100：fPCLK0 /160101：fPCLK0 /320110：fPCLK0 /640111：fPCLK0 /1281000：fPCLK0 /2561001：fPCLK0 /5121010：fPCLK0 /1024其它：fPCLK0 /1024</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SPOS</name>
              <description>SPI信号口映射控制位信号SPOS值MISO0MOSI0SCK0SPOS[1:0]=00PA15PB0PB1SPOS[1:0]=01PA3PA2PA1SPOS[1:0]=10PA9PA8PA7</description>
              <bitOffset>14</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SPI_STS</name>
          <description>SPI标志位寄存器</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>SPIF</name>
              <description>SPI数据传送标志位该位由硬件置1，通过软件写1清0，用于指示当前SPI数据传输是否完成：0：数据传输未完成/进行中1：数据传输已完成</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RINEIF</name>
              <description>接收FIFO非空状态位用于指示当前接收FIFO是否为空： 0：接收FIFO为空1：接收FIFO非空该位由硬件置1，通过软件写1清0。注意：在DMA模式下，DMA读取接收缓存后，该位由DMA模块清零，此时用户无需通过软件清0。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TXEIF</name>
              <description>发送FIFO为空标志位用于指示当前发送FIFO是否为空：0：发送FIFO非空1：发送FIFO为空该位由硬件置1，通过软件写1清0。注意：在DMA模式下，DMA写入发送缓存后，该位由DMA模块清0，此时用户无需通过软件清0。</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RXFIF</name>
              <description>接收FIFO已满状态位该位只读，由硬件置起或清零，用于指示当前接收FIFO是否已满：0：接收FIFO未满1：接收FIFO已满</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RXHIF</name>
              <description>接收FIFO内有效数据超过一半状态位/中断状态位该位只读，由硬件置起或清零，用于指示当前接收FIFO的状态：0：接收FIFO的有效数据个数少于或等于FIFO一半1：接收FIFO的有效数据个数大于FIFO一半，如果此时RXHIE = 1，将产生中断</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>WCOL</name>
              <description>写入冲突标志位该位由硬件置1，通过软件写1清0，用于指示是否发生写入冲突：0：未检测到写入冲突1：检测到一个写入冲突</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SPI_DATA</name>
          <description>SPI数据寄存器</description>
          <addressOffset>0xC</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
        </register>
        <register>
          <name>SPI_IDE</name>
          <description>通信口DMA控制寄存器</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>INTEN</name>
              <description>中断请求 CPU的使能控制位0：禁止中断请求1：使能中断请求</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RXNEIE</name>
              <description>接收FIFO非空中断使能位0：RXNEIF置起，不允许产生中断1：RXNEIF置起，产生中断</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TBIE</name>
              <description>发送FIFO为空时的中断使能位0：TXEIF置起时，不允许产生中断1：TXEIF置起时，产生中断</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RXIE</name>
              <description>接收FIFO已满中断使能位0：RXFIF置起时，不允许产生中断1：RXFIF置起时，产生中断</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RXHIE</name>
              <description>接收FIFO内有效数据超过一半中断使能位0：RXHIF置起时，不允许产生中断1：RXHIF置起时，产生中断</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TXHIE</name>
              <description>发送FIFO内有效数据不满一半中断使能位0：TXHIF置起时，不允许产生中断1：TXHIF置起时，产生中断</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RXDMAEN</name>
              <description>DMA接收通道使能位0：禁用DMA接收功能1：使能DMA接收功能该位使能后，RXNEIF置起可触发DMA通道接收请求</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>SPI1</name>
      <description>SPI1</description>
      <groupName/>
      <baseAddress>0x40021040</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x14</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>SPI1</name>
        <description>&lt; SPI1 Interrupts</description>
        <value>10</value>
      </interrupt>
      <registers>
        <register>
          <name>SPI_CON</name>
          <description>SPI控制寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>MSTR</name>
              <description>SPI主从机模式选择位0：SPI1为从设备1：SPI1为主设备</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SPMD</name>
              <description>SPI传输模式选择位0：8位模式1：16位模式</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DORD</name>
              <description>SPI传送方向选择位0：MSB优先发送1：LSB优先发送</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CPHA</name>
              <description>SPI时钟相位控制位0：SCK周期的第一沿采集数据1：SCK周期的第二沿采集数据</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CPOL</name>
              <description>SPI时钟极性控制位0：SCK在空闲状态下为低电平1：SCK在空闲状态下为高电平</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SPEN</name>
              <description>SPI使能控制位0：关闭SPI11：打开SPI1</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SPR</name>
              <description>SPI时钟预分频控制位0000：fPCLK10001：fPCLK1 /20010：fPCLK1 /40011：fPCLK1 /80100：fPCLK1 /160101：fPCLK1 /320110：fPCLK1 /640111：fPCLK1 /1281000：fPCLK1 /2561001：fPCLK1 /5121010：fPCLK1 /1024其它：fPCLK1 /1024</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SPOS</name>
              <description>SPI信号口映射控制位信号SPOS值MISO1MOSI1SCK1SPOS[1:0]=00PA14PA13PA12SPOS[1:0]=01PA4PA5PA6</description>
              <bitOffset>14</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SPI_STS</name>
          <description>SPI标志位寄存器</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>SPIF</name>
              <description>SPI数据传送标志位该位由硬件置1，通过软件写1清0，用于指示当前SPI数据传输是否完成：0：数据传输未完成/进行中1：数据传输已完成</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>WCOL</name>
              <description>写入冲突标志位该位由硬件置1，通过软件写1清0，用于指示是否发生写入冲突：0：未检测到写入冲突1：检测到一个写入冲突</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SPI_DATA</name>
          <description>SPI数据寄存器</description>
          <addressOffset>0xC</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
        </register>
        <register>
          <name>SPI_IDE</name>
          <description>通信口DMA控制寄存器</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>INTEN</name>
              <description>中断请求 CPU的使能控制位0：禁止中断请求1：使能中断请求</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RXDMAEN</name>
              <description>DMA接收通道使能位0：禁用DMA接收功能1：使能DMA接收功能该位使能后，SPIF置起可触发DMA通道接收请求</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TXDMAEN</name>
              <description>DMA发送通道使能位0：禁用DMA发送功能1：使能DMA发送功能该位使能后，TXEIF置起可触发DMA通道发送请求</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>TWI0</name>
      <description>TWI0</description>
      <groupName/>
      <baseAddress>0x40020060</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x14</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>TWI0</name>
        <description>&lt; TWI0 Interrupt</description>
        <value>23</value>
      </interrupt>
      <registers>
        <register>
          <name>TWI_CON</name>
          <description>TWI控制寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>STRETCH</name>
              <description>TWI时钟延长使能位该位仅在从机模式下有效0：禁止时钟延长1：允许时钟延长，主机需要支持时钟延长功能说明：在数据传输完成之后，且ACK为0，此时时钟延长发生。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>AA</name>
              <description>TWI应答使能位0：无应答，返回UACK（应答位为高电平）1：在接收到一个匹配的地址或数据后返回一个应答ACK</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>STO</name>
              <description>TWI停止位触发开关主机模式下，对该位写1，在当前字节传输或起始条件发出后产生停止条件。软件可以设置或清除该位，或当检测到停止条件时，由硬件清除。</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>STA</name>
              <description>TWI起始位触发开关该位写1将产生起始条件，TWI将切换为主机模式。软件可以设置或清除该位，或当起始条件发出后，由硬件清0。</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TWEN</name>
              <description>TWI使能控制位0：关闭TWI1：打开TWI</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TWCK</name>
              <description>主机模式下TWI的通信速率设定：0000：fPCLK /4096 0001：fPCLK /20480010：fPCLK /10240011：fPCLK /5120100：fPCLK /2560101：fPCLK /1280110：fPCLK /640111：fPCLK /321000：fPCLK /161001：fPCLK /81010：fPCLK /4其它：fPCLK /4TWI0的通信速率fT</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SPOS</name>
              <description>TWI0信号口映射控制位@TWI0_CON                                  信号SPOS值SCL0SDA0SPOS[1:0]=00PB1PB0SPOS[1:0]=01PC10PC11SPOS[1:0]=10PA6PA5SPOS[1:0]=11PA13PA14TWI1信号口映射控制位@TWI1_CON                                 </description>
              <bitOffset>14</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TWI_STS</name>
          <description>TWI标志位寄存器</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>TWIF</name>
              <description>TWI中断标志位该位由硬件置1，通过软件写1清0。主机模式：发送启动信号发送完地址帧接收或发送完数据帧从机模式：第一帧地址匹配成功成功接收或发送8位数据接收到重复起始条件从机收到停止信号</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TXERXE</name>
              <description>TWI传输完成标志位以下情况，TXnE/RXnE由硬件置1主机模式：主机发送地址帧（写），且收到从机的ACK主机发送完数据，且接收到从机ACK主机接收到数据，且主机回从机ACK从机模式：从机接收地址帧（读），且和从机地址（TWA）匹配从机接收到数据，且从机回主机ACK从机发送完数据，且接收到主机ACK（AA=1）对TWIDAT进行读写操作后，该位将被硬件清除。</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>GCA</name>
              <description>TWI通用地址响应标志位0：非响应通用地址1：当GC置1，同时通用地址匹配时该位由硬件置1，并自动清0</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>MSTR</name>
              <description>TWI主/从机模式标志位0：从机模式1：主机模式说明：当TWI接口向总线发出起始条件后，会自动切换为主机模式，同时硬件将该位置位；当总线上检测到一个停止条件时，硬件清除该位。</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>STATE</name>
              <description>TWI状态位用于指示TWI状态，主/从机模式下状态位含义不同。从机模式：000：从机处于空闲状态，等待TWEN置1，检测TWI 启动信号。当从机接收到停止条件后跳转到此状态001：从机正在接收第一帧地址和读写位（第8位为读写位，1为读，0为写）。从机接收到起始条件后会跳转到此状态010：从机接收数据状态011：从机发送数据状态100：在从机发送数据状态中，当主机回UACK时跳转到此状态，等待重新启</description>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>NBYTES</name>
              <description>收发缓存字节数设置位用于设置待发送/接收的字节数。每发送/接收成功一个自己NBYTES自动减1，当NBYTES为0时TC标志位将置起。注意：STA置1时不允许修改。</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TWI_ADD</name>
          <description>TWI地址寄存器</description>
          <addressOffset>0x8</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
        </register>
        <register>
          <name>TWI_DATA</name>
          <description>TWI数据寄存器</description>
          <addressOffset>0xC</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
        </register>
        <register>
          <name>TWI_IDE</name>
          <description>通信口DMA控制寄存器</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>INTEN</name>
              <description>中断请求 CPU的使能控制位0：禁止中断请求1：使能中断请求</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RXDMAEN</name>
              <description>DMA接收通道使能位0：禁用DMA接收功能1：使能DMA接收功能该位使能后，TXnE/RXnE置起可触发DMA通道接收请求注意：TWI0可产生DMA请求TWI1不能产生DMA请求</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TXDMAEN</name>
              <description>DMA发送通道使能位0：禁用DMA发送功能1：使能DMA发送功能该位使能后，TXnE/RXnE置起可触发DMA通道发送请求注意：TWI0可产生DMA请求TWI1不能产生DMA请求</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
