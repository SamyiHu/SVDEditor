              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EPWMNB</name>
              <description>TnEX_PWMB所在管脚 PWM波形输出使能位0：关闭1：使能</description>
