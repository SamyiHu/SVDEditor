注意：捕获模式下，该位软件清0之前不允许更新TnRCAP值</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EXIF</name>
              <description>外部事件输入下降沿被检测到的标志位该位由硬件置1，通过软件写1清0。
0：无外部事件输入
1：检测到外部输入(如果EXENF = 1，由硬件设1)
注意：捕获模式下，该位软件清0之前不允许更新TnFCAP值</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIM_PDTA_RCAP</name>
          <description>TIMER Rise Caputre Key register</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
        </register>
        <register>
          <name>TIM_PDTB_FCAP</name>
          <description>TIMER fall Caputre register</description>
          <addressOffset>0x14</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
        </register>
        <register>
          <name>TIM_IDE</name>
          <description>TIMn的中断使能及DMA控制寄存器</description>
          <addressOffset>0x18</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>INTEN</name>
              <description>中断请求 CPU的使能控制位0：禁止中断请求1：使能中断请求</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TIE</name>
              <description>定时器溢出中断开关
0：禁止溢出中断
1：使能溢出中断</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EXIRE</name>
              <description>外部事件输入上升沿中断开关
0：禁止上升沿中断
1：使能上升沿中断</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EXIFE</name>
              <description>外部事件输入下降沿中断开关
0：禁止下降沿中断
1：使能下降沿中断</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TIDE</name>
              <description>定时器溢出事件触发DMA请求使能位
0：定时器溢出禁止产生DMA请求
1：定时器溢出允许产生DMA请求</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CAPRDE</name>
              <description>上升沿捕获事件触发DMA请求使能位
0：上升沿捕获事件禁止产生DMA请求
1：产生新的下降沿捕获时，触发DMA请求，DMA搬运RCAP寄存器的值</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
