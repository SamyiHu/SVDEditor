        <register>
          <name>TWI_ADD</name>
          <description>TWI地址寄存器</description>
          <addressOffset>0x8</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
        </register>
        <register>
          <name>TWI_DATA</name>
          <description>TWI数据寄存器</description>
          <addressOffset>0xC</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
        </register>
        <register>
          <name>TWI_IDE</name>
          <description>通信口DMA控制寄存器</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>INTEN</name>
              <description>中断请求 CPU的使能控制位0：禁止中断请求1：使能中断请求</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>RXDMAEN</name>
              <description>DMA接收通道使能位0：禁用DMA接收功能1：使能DMA接收功能该位使能后，TXnE/RXnE置起可触发DMA通道接收请求注意：TWI0可产生DMA请求TWI1不能产生DMA请求</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TXDMAEN</name>
              <description>DMA发送通道使能位0：禁用DMA发送功能1：使能DMA发送功能该位使能后，TXnE/RXnE置起可触发DMA通道发送请求注意：TWI0可产生DMA请求TWI1不能产生DMA请求</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>TIM0</name>
      <description>TIM0</description>
      <groupName/>
      <baseAddress>0x40020100</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1C</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>TIM_CON</name>
          <description>定时器控制寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>CPRL</name>
              <description>捕获/重载方式设置位
0：重载功能
1：捕获功能</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CTSEL</name>
              <description>定时器/计数器选定位
0：定时器方式
1：计数器方式</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EXENR</name>
              <description>Tn引脚上的上升沿信号捕获使能位
0：忽略Tn引脚上的事件
1：检测到Tn引脚上一个上升沿，产生一个捕获，EXIR被置起，TnCNT寄存器的值捕获到寄存器RCAP里</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EXENF</name>
              <description>下降沿信号捕获使能位:0：忽略Tn引脚上的事件
1：检测到Tn引脚上一个下降沿，产生一个捕获，EXIF被置起，TnCNT寄存器的值捕获到寄存器FCAP里</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FSEL</name>
              <description>下降沿信号选择位该位仅在捕获模式（CPRL=1)下有效
0：检测到Tn引脚上一个下降沿，产生一个捕获。忽略TnEX引脚上的事件
1：检测到TnEX引脚上一个下降沿，产生一个捕获。忽略Tn引脚上的事件</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EXENX</name>
              <description>TnEX设置位，n=0该位在不同模式下作用不同：重载模式：（CPRL = 0）
该位用于控制TnEX引脚上的外部事件输入(下降沿)，用作重载允许/禁止控制：
0：忽略TnEX引脚上的事件
1：检测到TnEX引脚上一个下降沿，产生一个重载捕获模式：（CPRL = 1）
该位用作TnEX下降沿信号捕获选通位：
0：忽略TnEX引脚上的事件
1：当FSEL = 1，检测到TnEX引脚上一个下降沿，产生一</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>DEC</name>
              <description>递增/递减方向控制位
0：TIMn为递增的定时/计数器
1：TIMn作为递增/递减的定时/计数器，TnEX用来选择计数方向</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TR</name>
              <description>TIMn开始/停止控制位，n=0~7
0：停止TIMn / TPWMn计数器
1：开始TIMn / TPWMn计数器</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TIMCLK</name>
              <description>TIM时钟频率档位控制位000：fTIM/1001：fTIM/2010：fTIM/4011：fTIM/8100：fTIM/16101：fTIM/32110：fTIM/64111：fTIM/128fTIM对应的时钟可能为fPCLK 或Tn输入</description>
              <bitOffset>8</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INVNB</name>
              <description>TPWMnB波形输出反向控制位0：正常1：波形输出反向</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INVNA</name>
              <description>TPWMnA波形输出反向控制位0：正常1：波形输出反向</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EPWMNB</name>
              <description>TnEX_PWMB所在管脚 PWM波形输出使能位0：关闭1：使能</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EPWMNA</name>
              <description>Tn_PWMA所在管脚 PWM波形输出使能位0：关闭1：使能</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TXOE</name>
              <description>Tn引脚信号方向控制位0：Tn作为时钟输入口或I/O 端口1：Tn用于可编程时钟输出</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SPOS</name>
              <description>TIM2管脚映射控制位@ TIM2_CON                                    信号SPOS值T2CAP/T2SPOS=0PA10SPOS=1PA12TIM3管脚映射控制位@ TIM3_CON                                    信号SPOS值T3CAP/T3SPOS=0PA0SPOS=1PA13TIM7管脚映射控制位@ TIM7</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIM_CNT</name>
          <description>定时器计数值寄存器</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
        </register>
        <register>
          <name>TIM_RLD</name>
          <description>定时器重载寄存器</description>
          <addressOffset>0x8</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
        </register>
        <register>
          <name>TIM_STS</name>
          <description>定时器标志位寄存器</description>
          <addressOffset>0xC</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>TIF</name>
              <description>定时器溢出标志位该位由硬件置1，通过软件写1清0。
0：无溢出(必须由软件清0)
1：溢出(如果RCLK = 0和TCLK = 0，由硬件设1)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EXIR</name>
              <description>Tn引脚外部事件输入上升沿被检测到的标志位该位由硬件置1，通过软件写1清0。
0：无外部事件输入
1：检测到外部输入(如果EXENR = 1，由硬件设1)
注意：捕获模式下，该位软件清0之前不允许更新TnRCAP值</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EXIF</name>
              <description>外部事件输入下降沿被检测到的标志位该位由硬件置1，通过软件写1清0。
0：无外部事件输入
1：检测到外部输入(如果EXENF = 1，由硬件设1)
注意：捕获模式下，该位软件清0之前不允许更新TnFCAP值</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIM_PDTA_RCAP</name>
          <description>TIMER Rise Caputre Key register</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
        </register>
        <register>
          <name>TIM_PDTB_FCAP</name>
          <description>TIMER fall Caputre register</description>
          <addressOffset>0x14</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
        </register>
        <register>
          <name>TIM_IDE</name>
          <description>TIMn的中断使能及DMA控制寄存器</description>
          <addressOffset>0x18</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>INTEN</name>
              <description>中断请求 CPU的使能控制位0：禁止中断请求1：使能中断请求</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TIE</name>
              <description>定时器溢出中断开关
0：禁止溢出中断
1：使能溢出中断</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EXIRE</name>
              <description>外部事件输入上升沿中断开关
0：禁止上升沿中断
1：使能上升沿中断</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EXIFE</name>
              <description>外部事件输入下降沿中断开关
0：禁止下降沿中断
1：使能下降沿中断</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TIDE</name>
              <description>定时器溢出事件触发DMA请求使能位
0：定时器溢出禁止产生DMA请求
1：定时器溢出允许产生DMA请求</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CAPRDE</name>
              <description>上升沿捕获事件触发DMA请求使能位
0：上升沿捕获事件禁止产生DMA请求
1：产生新的下降沿捕获时，触发DMA请求，DMA搬运RCAP寄存器的值</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CAPFDE</name>
              <description>下降沿捕获事件触发DMA请求使能位
0：下降沿捕获事件禁止产生DMA请求
1：产生新的下降沿捕获时，触发DMA请求，DMA搬运FCAP寄存器的值</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
