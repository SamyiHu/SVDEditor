              <name>TXOE</name>
              <description>Tn引脚信号方向控制位0：Tn作为时钟输入口或I/O 端口1：Tn用于可编程时钟输出</description>
              <bitOffset>15</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>SPOS</name>
              <description>TIM2管脚映射控制位@ TIM2_CON                                    信号SPOS值T2CAP/T2SPOS=0PA10SPOS=1PA12TIM3管脚映射控制位@ TIM3_CON                                    信号SPOS值T3CAP/T3SPOS=0PA0SPOS=1PA13TIM7管脚映射控制位@ TIM7</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIM_CNT</name>
          <description>定时器计数值寄存器</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
        </register>
        <register>
          <name>TIM_RLD</name>
          <description>定时器重载寄存器</description>
          <addressOffset>0x8</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
        </register>
        <register>
          <name>TIM_STS</name>
          <description>定时标志位寄存器</description>
          <addressOffset>0xC</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>TIF</name>
              <description>定时器溢出标志位该位由硬件置1，通过软件写1清0。
0：无溢出(必须由软件清0)
1：溢出(如果RCLK = 0和TCLK = 0，由硬件设1)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EXIR</name>
              <description>Tn引脚外部事件输入上升沿被检测到的标志位该位由硬件置1，通过软件写1清0。
0：无外部事件输入
1：检测到外部输入(如果EXENR = 1，由硬件设1)
注意：捕获模式下，该位软件清0之前不允许更新TnRCAP值</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EXIF</name>
              <description>外部事件输入下降沿被检测到的标志位该位由硬件置1，通过软件写1清0。
0：无外部事件输入
1：检测到外部输入(如果EXENF = 1，由硬件设1)
注意：捕获模式下，该位软件清0之前不允许更新TnFCAP值</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TIM_PDTA_RCAP</name>
          <description>TIMER Rise Caputre Key register</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
        </register>
        <register>
          <name>TIM_PDTB_FCAP</name>
          <description>TIMER fall Caputre register</description>
          <addressOffset>0x14</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
        </register>
        <register>
          <name>TIM_IDE</name>
          <description>TIMn的中断使能及DMA控制寄存器</description>
          <addressOffset>0x18</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>INTEN</name>
              <description>中断请求 CPU的使能控制位0：禁止中断请求1：使能中断请求</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TIE</name>
              <description>定时器溢出中断开关
0：禁止溢出中断
1：使能溢出中断</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EXIRE</name>
              <description>外部事件输入上升沿中断开关
0：禁止上升沿中断
1：使能上升沿中断</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>EXIFE</name>
              <description>外部事件输入下降沿中断开关
0：禁止下降沿中断
1：使能下降沿中断</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>TIDE</name>
              <description>定时器溢出事件触发DMA请求使能位
0：定时器溢出禁止产生DMA请求
1：定时器溢出允许产生DMA请求</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CAPRDE</name>
              <description>上升沿捕获事件触发DMA请求使能位
0：上升沿捕获事件禁止产生DMA请求
1：产生新的下降沿捕获时，触发DMA请求，DMA搬运RCAP寄存器的值</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>CAPFDE</name>
              <description>下降沿捕获事件触发DMA请求使能位
0：下降沿捕获事件禁止产生DMA请求
1：产生新的下降沿捕获时，触发DMA请求，DMA搬运FCAP寄存器的值</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>PWM0</name>
      <description>PWM0</description>
      <groupName/>
      <baseAddress>0x40020200</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x34</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>PWM0</name>
        <description>&lt; PWM0 Interrupt</description>
        <value>21</value>
      </interrupt>
      <registers>
        <register>
          <name>PWM_CON</name>
          <description>PWM0控制寄存器</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>PWMCLK</name>
              <description>PWMCLK</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PWMMD1</name>
              <description>PWM波形互补模式设置位0：独立模式1：互补模式</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PWMMD0</name>
              <description>PWM波形对齐模式选择位0：边沿对齐模式1：中心对齐模式</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ENPWM</name>
              <description>PWM模块开关控制位1：允许Clock进到 PWM 单元，PWM处于工作状态，PWM输出口的状态由寄存器ENPWMx控制（x=0~7）0：PWM单元停止工作，PWM计数器清0，全部 PWM输出口设置为GPIO状态</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INTEN</name>
              <description>中断请求 CPU 的使能控制位0：禁止中断请求1：使能中断请求</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PWM_CHN</name>
          <description>PWM0通道设置寄存器</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>ENPWM0</name>
              <description>ENPWM0</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ENPWM1</name>
              <description>ENPWM1</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ENPWM2</name>
              <description>ENPWM2</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ENPWM3</name>
              <description>ENPWM3</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ENPWM4</name>
              <description>ENPWM4</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ENPWM5</name>
              <description>ENPWM5</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ENPWM6</name>
              <description>ENPWM6</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ENPWM7</name>
              <description>ENPWM7</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PWM_STS</name>
          <description>PWM0状态标志寄存器</description>
          <addressOffset>0x8</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>PWMIF</name>
              <description>PWM中断请求标志位该位由硬件置1，通过软件写1清0。当PWM 计数器溢出时(即：计数值超过 PWMPD)，该位由硬件置1。如果此时PWM0_CON.INTEN = 1，将产生 PWM0 中断 。</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FLTSTA</name>
              <description>PWM故障检测状态标志位0：PWM处于正常输出状态；1：故障检测有效，PWM输出处于高阻状态，如果处于锁存模式，此位可软件清0</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PWM_INV</name>
          <description>PWM0波形输出反向控制寄存器</description>
          <addressOffset>0xC</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>INV0</name>
              <description>INV0</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INV1</name>
              <description>PWM0x波形输出反向控制1：PWM0x波形输出反向0：PWM0x波形输出不反向</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INV2</name>
              <description>INV2</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INV3</name>
              <description>INV3</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INV4</name>
              <description>INV4</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INV5</name>
              <description>INV5</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INV6</name>
              <description>INV6</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>INV7</name>
              <description>INV7</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PWM_DFR</name>
          <description>PWM0死区设置寄存器</description>
          <addressOffset>0x10</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>PDR</name>
              <description>上升沿死区时间设置位此位仅在互补模式设置有效：PWM 上升沿死区时间= 4*PDR[3:0] / fPCLK</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>PDF</name>
              <description>下降沿死区时间设置位此位仅在互补模式设置有效：PWM下降沿死区时间= 4*PDF[3:0] / fPCLK</description>
              <bitOffset>8</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PWM_FLT</name>
          <description>PWM0故障检测设置寄存器</description>
          <addressOffset>0x14</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>FLTDT</name>
              <description>PWM故障检测输入信号滤波时间设置00：滤波时间为001：滤波时间为1us10：滤波时间为4us11：滤波时间为16us</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FLTTV</name>
              <description>PWM故障检测电平选择位0：故障检测低电平有效1：故障检测高电平有效</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FLTMD</name>
              <description>PWM故障检测模式设置位0：锁存模式，当故障输入有效时，故障检测状态标志位FLTSTA由硬件置1，PWM停止输出，当故障输入无效时FLTSTA状态不变1：立即模式：当故障输入有效时，故障检测状态标志位FLTSTA由硬件置1，PWM停止输出，当故障输入无效时FLTSTA状态立刻被硬件清0，PWM波形将在PWM计数器计数到0时恢复输出</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>FLTEN</name>
              <description>PWM故障检测功能控制位0：故障检测功能关闭1：故障检测功能开启</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PWM_CYCLE</name>
          <description>PWM0周期寄存器</description>
          <addressOffset>0x18</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
        </register>
        <register>
          <name>PWM_DT</name>
          <description>PWM Duty register</description>
          <addressOffset>0x30</addressOffset>
          <size>0x20</size>
          <resetValue>0x0</resetValue>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>PWM1</name>
